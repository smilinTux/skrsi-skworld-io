    {
      "dot": "amber",
      "title": "Proposes, never authorizes",
      "items": [
        "A valid record confers no merge, deployment, credential, or actuation power",
        "Feedback is proposal-only, routed through the adopter's own existing lifecycle gates"
      ]
    },
    {
      "dot": "cyan",
      "title": "Independent review is enforced",
      "items": [
