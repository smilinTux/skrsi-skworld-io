  "cards": [
    {
      "dot": "amber",
      "title": "Proposes, never authorizes",
      "items": [
        "The workflow is advisory: it never fails a PR and is never a required check",
        "An evaluation record or comment grants no merge, deployment, or actuation power"
      ]
    },
    {
      "dot": "cyan",
      "title": "Owns no runtime data",
      "items": [
        "The repo holds schemas, synthetic examples and its own targets",
        "Evaluation records live with each adopter: PR comments, artifacts, committed records"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two ways in",
      "items": [
        "CI: an adopter PR calls evaluate.yml, which benches head and base",
        "Live: the adopter benches where its data is and calls build_evaluation.py locally"
      ]
    }
